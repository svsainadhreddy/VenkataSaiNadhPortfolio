<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Venkata Sai Nadh</title>

    <meta name="description"
          content="Venkata Sai Nadh - ASP.NET Core Developer, C#, Python and Machine Learning." />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <!-- Navigation -->

    <header class="navbar-wrapper">

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-dot"></span>

                    SAINADH<span>.DEV</span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation">

                    <i class="bi bi-list"></i>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               href="#about">
                                About
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="#skills">
                                Skills
                            </a>
                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Projects"
                               asp-action="Index">

                                Projects

                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="#education">
                                Education
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="#contact">
                                Contact
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">

                            <a class="resume-button"
                               href="/resume/Venkata_Sai_Nadh_Resume.pdf"
                               target="_blank">

                                <i class="bi bi-file-earmark-pdf"></i>
                                Resume

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Content -->

    <main>

        @RenderBody()

    </main>


    <!-- Footer -->

    <footer class="footer">

        <div class="container">

            <div class="footer-content">

                <div>

                    <h3>SAINADH<span>.DEV</span></h3>

                    <p>
                        Building practical software with
                        modern technologies.
                    </p>

                </div>

                <div class="social-links">

                    <a href="https://github.com/"
                       target="_blank"
                       aria-label="GitHub">

                        <i class="bi bi-github"></i>

                    </a>

                    <a href="https://linkedin.com/in/venkatasainadhreddysanikommu798"
                       target="_blank"
                       aria-label="LinkedIn">

                        <i class="bi bi-linkedin"></i>

                    </a>

                    <a href="mailto:svsai798@gmail.com"
                       aria-label="Email">

                        <i class="bi bi-envelope"></i>

                    </a>

                </div>

            </div>

            <div class="footer-bottom">

                <span>
                    © @DateTime.Now.Year Venkata Sai Nadh
                </span>

                <span>
                    Designed & Built with ASP.NET Core
                </span>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>